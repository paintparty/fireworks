{:paths ["src"]

 :deps {org.clojure/clojure            {:mvn/version "1.12.0"}
        io.github.paintparty/fireworks {:mvn/version "0.21.3"}}

 :aliases
 {:fireworks
  {:extra-paths   ["test"]
   :extra-deps    {com.jakemccrary/test-refresh {:mvn/version "0.26.0"}}
   :override-deps {io.github.paintparty/fireworks {:local/root "../../../../../../fireworks"}}
   :main-opts     ["-m" "com.jakemccrary.test-refresh"]
   :jvm-opts      ["-Dfireworks.elide=true"]}}}

;; The :fireworks alias (and this commentary) was added by Fireworks (A VSCode extension).

;; The extension command `Fireworks: Live Code`, with `Integrated Terminal`
;; selected will run: `clojure -M:fireworks`.
;; Or, in your preferred external terminal: `clojure -M:fireworks`

;; The `test-refresh` lib watches `src/` + `test/`, reloads on save,
;; re-runs top-level `fireworks.core/?` forms) and (optionally) runs tests.

;; To elide fireworks for non-dev builds -> {:jvm-opts ["-Dfireworks.elide=true"]}
;; This elision will expand calls to the `fireworks.core/?` macro to the value (no runtime printing).
